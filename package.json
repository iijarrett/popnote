{
  "name": "popnote",
  "version": "0.0.6",
  "private": true,
  "description": "Open a note in a floating Obsidian desktop window.",
  "scripts": {
    "check": "tsc --noEmit",
    "build": "npm run check && node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch"
  },
  "devDependencies": {
    "esbuild": "0.25.5",
    "obsidian": "1.14.4",
    "typescript": "5.8.3"
  }
}
